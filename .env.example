# LexVault.ch - Environment Configuration
# Copy to .env and fill in your values

# ===========================================
# Azure OpenAI (Switzerland North Region)
# ===========================================
# IMPORTANT: Use ONLY Switzerland North endpoints for data sovereignty
# Format: https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT_CH=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here

# Azure deployment names (must match your Azure OpenAI deployments)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_MODEL_DEPLOYMENT=gpt-4

# ===========================================
# Weaviate (Local - handled by Docker)
# ===========================================
WEAVIATE_URL=http://localhost:8080
